{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🍺 测试（全部）",
            "type": "lua",
            "request": "launch",
            "stopOnEntry": false,
            "program": "${workspaceFolder}/server/main.lua",
            "luaexe": "${workspaceFolder}/server/bin/moe-kill",
            "windows": {
                "luaexe": "${workspaceFolder}/server/bin/moe-kill.exe"
            },
            "luaVersion": "lua55",
            "sourceCoding": "utf8",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "outputCapture": [
                "print",
                "stderr"
            ],
            "skipFiles": [
                "server/tools/class.lua"
            ],
            "arg": [
                "--test"
            ]
        },
        {
            "name": "🍺 测试（单个套件）",
            "type": "lua",
            "request": "launch",
            "stopOnEntry": false,
            "program": "${workspaceFolder}/server/main.lua",
            "luaexe": "${workspaceFolder}/server/bin/moe-kill",
            "windows": {
                "luaexe": "${workspaceFolder}/server/bin/moe-kill.exe"
            },
            "luaVersion": "lua55",
            "sourceCoding": "utf8",
            "console": "integratedTerminal",
            "outputCapture": [
                "print",
                "stderr"
            ],
            "skipFiles": [
                "server/tools/class.lua"
            ],
            "arg": [
                "--test",
                "smoke.await"
            ]
        },
        {
            "name": "🍄 附加（attach）",
            "type": "lua",
            "request": "attach",
            "stopOnEntry": false,
            "address": "127.0.0.1:11418",
            "sourceFormat": "string",
            "sourceMaps": [
                [
                    "server/*",
                    "${workspaceFolder}/server/*"
                ]
            ],
            "windows": {
                "sourceMaps": [
                    [
                        "server\\*",
                        "${workspaceFolder}/server/*"
                    ]
                ]
            },
            "skipFiles": [
                "server/tools/class.lua",
                "${workspaceFolder}/server/tools/class.lua"
            ]
        }
    ]
}
